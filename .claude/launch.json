{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vip-app",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true",
        "--browser.gatherUsageStats",
        "false"
      ],
      "port": 8501
    },
    {
      "name": "vip-web",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8600",
        "--directory",
        "docs"
      ],
      "port": 8600
    }
  ]
}